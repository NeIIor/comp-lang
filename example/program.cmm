dim arr 10;

main
{
    scan(x);

    i = 0;
    while(i < 10)
    {
        arr[i] = i * i;
        i = i + 1;
    }

    i = 0;
    while(i < 10)
    {
        print(arr[i]);
        i = i + 1;
    }

    print(factorial(x));
}

factorial(x)
{
    if (x <= 1)
    {
        return 1;
    }

    return x * factorial(x - 1);
}
